#     python partA/build_corpus.py
#
# NOTE: partA/corpus/flores/*.txt and partA/corpus/in22/*.txt ARE committed on
# purpose -- they are the eval set, and the audit numbers are only reproducible
# against those exact files (manifest.json carries their SHA-256).
